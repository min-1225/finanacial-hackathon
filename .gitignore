# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# 예시 파일은 저장소에 올린다. 실제 값은 들어가지 않는다.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local env (실제 API 키가 들어가는 파일)
.env.local
.env.*.local

# Claude 데스크톱 앱이 만드는 출력 폴더.
# API 키 사본이나 스크린샷이 들어갈 수 있으므로 통째로 제외한다.
Claude outputs/
"Claude outputs"/

# 확장자 없는 env 사본까지 방어
env.local
*.env.local
