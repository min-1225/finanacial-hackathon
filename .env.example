# SecondSign 환경변수 예시
# 실제 값은 .env.local 에 넣고 Git 에 올리지 않는다.

# Google AI Studio 에서 발급한 Gemini API 키.
# 서버 Route Handler 에서만 읽고 브라우저로 내려보내지 않는다.
GEMINI_API_KEY=

# 사용할 모델 이름. 신규 계정에서도 호출 가능한 모델을 기본값으로 사용한다.
GEMINI_MODEL=gemini-3.6-flash

# true 이면 AI 를 호출하지 않고 고정된 샘플 데이터를 사용한다.
# 화면 상단에 샘플 모드 표시가 함께 노출된다.
USE_FIXTURE_MODE=false
